:root {
  --bg-color: #161512;
  --card-bg: #21201d;
  --banner-bg: #262421;
  --green-accent: #81b64c;
  --green-hover: #72a242;
  --text-white: #ffffff;
  --text-dim: #bababa;
  
  /* ألوان التقييمات الرسمية الشطرنجية */
  --c-best: #96bc4b;
  --c-great: #5c8bb0;
  --c-good: #a8a8a8;
  --c-inaccuracy: #f0c15c;
  --c-mistake: #e6912c;
  --c-blunder: #ca3431;
  --c-book: #d5a47d;
}

body {
  margin: 0;
  background-color: var(--bg-color);
  color: var(--text-white);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 10px;
  box-sizing: border-box;
}

.review-app {
  width: 100%;
  max-width: 480px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* البانر العلوي (معلومات النقلة والمدرب) */
.header-banner {
  background: var(--banner-bg);
  border-radius: 8px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid #312e2b;
  box-shadow: 0 4px 6px rgba(0,0,0,0.2);
}

.coach-avatar {
  font-size: 28px;
}

.banner-content {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  overflow: hidden;
}

.eval-pill {
  background: #fff;
  color: #000;
  font-weight: bold;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 13px;
  flex-shrink: 0;
}

.banner-text {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.move-title {
  font-weight: bold;
  font-size: 14px;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.move-desc {
  font-size: 12px;
  color: var(--text-dim);
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

/* قسم المخطط البياني للتقييم (Chart.js) */
.chart-container {
  background: var(--card-bg);
  border-radius: 6px;
  padding: 8px;
  height: 60px;
  border: 1px solid #312e2b;
  position: relative;
}

.chart-container canvas {
  width: 100% !important;
  height: 100% !important;
}

/* الرقعة وشريط التقييم */
.board-container {
  display: flex;
  gap: 6px;
  width: 100%;
}

.eval-bar-wrapper {
  width: 14px;
  background: #262421;
  border-radius: 3px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  border: 1px solid #312e2b;
}

.eval-bar-fill {
  width: 100%;
  height: 50%;
  background: #ffffff;
  transition: height 0.3s ease;
}

.chess-board {
  flex: 1;
  aspect-ratio: 1;
  position: relative;
  border-radius: 4px;
  overflow: hidden;
}

/* الشارات التقييمية العائمة على الرقعة */
.square-eval-badge {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: bold;
  color: #fff;
  z-index: 20;
  border: 2px solid #fff;
  box-shadow: 0 2px 6px rgba(0,0,0,0.7);
}

/* شريط النقلات الأفقي السلس */
.moves-history-bar, .moves-scroll {
  background: var(--card-bg);
  border-radius: 6px;
  padding: 8px;
  overflow-x: auto;
  white-space: nowrap;
  display: flex;
  gap: 6px;
  border: 1px solid #312e2b;
  scrollbar-width: thin;
  scrollbar-color: #383631 transparent;
}

.chip-move {
  background: #2b2926;
  border: 1px solid #383631;
  color: #fff;
  padding: 6px 12px;
  border-radius: 4px;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.2s;
}

.chip-move:hover {
  background: #383631;
}

.chip-move.active {
  background: var(--green-accent);
  border-color: var(--green-accent);
  font-weight: bold;
}

/* أزرار التحكم السفلية */
.controls-bar {
  display: flex;
  gap: 8px;
}

.ctrl-btn {
  background: #2b2926;
  border: 1px solid #312e2b;
  color: #fff;
  padding: 12px;
  border-radius: 8px;
  font-size: 16px;
  cursor: pointer;
  flex: 1;
  transition: background 0.2s;
}

.ctrl-btn:hover {
  background: #383631;
}

.btn-next {
  background: var(--green-accent);
  border-color: var(--green-accent);
  font-weight: bold;
  flex: 2;
}

.btn-next:hover {
  background: var(--green-hover);
}

/* إدخال البيانات (PGN) */
.input-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: var(--card-bg);
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #312e2b;
}

textarea {
  width: 100%;
  height: 50px;
  background: #181715;
  border: 1px solid #312e2b;
  color: #fff;
  border-radius: 6px;
  padding: 8px;
  box-sizing: border-box;
  font-size: 11px;
  resize: none;
}

textarea:focus {
  outline: none;
  border-color: var(--green-accent);
}

.btn-main {
  background: var(--green-accent);
  border: none;
  color: #fff;
  padding: 10px;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
  width: 100%;
  transition: background 0.2s;
}

.btn-main:hover {
  background: var(--green-hover);
}

/* خلفيات التقييم الملونة */
.bg-best { background: var(--c-best); }
.bg-great { background: var(--c-great); }
.bg-good { background: var(--c-good); }
.bg-inaccuracy { background: var(--c-inaccuracy); }
.bg-mistake { background: var(--c-mistake); }
.bg-blunder { background: var(--c-blunder); }
.bg-book { background: var(--c-book); }
