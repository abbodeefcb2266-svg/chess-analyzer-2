:root {
  --bg-color: #0f172a;
  --card-bg: #1e293b;
  --accent-color: #f59e0b;
  --accent-hover: #d97706;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --border-color: #334155;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  display: flex;
  justify-content: center;
  padding: 20px;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 1000px;
  width: 100%;
}

@media (min-width: 768px) {
  .container {
    flex-direction: row;
  }
}

.board-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.game-info {
  width: 100%;
  max-width: 480px;
  background: var(--card-bg);
  padding: 12px 16px;
  border-radius: 8px 8px 0 0;
  display: flex;
  justify-content: space-between;
  font-weight: bold;
}

.game-result {
  color: var(--accent-color);
}

.board {
  width: 100%;
  max-width: 480px;
  aspect-ratio: 1;
}

/* دعم السحب والإسقاط */
.board.drag-over {
  border: 3px dashed var(--accent-color);
  opacity: 0.8;
}

.controls {
  margin-top: 15px;
  display: flex;
  gap: 10px;
  background: var(--card-bg);
  padding: 8px 16px;
  border-radius: 30px;
}

.controls button {
  background: none;
  border: none;
  color: var(--text-main);
  font-size: 20px;
  cursor: pointer;
  padding: 5px 12px;
  border-radius: 6px;
  transition: 0.2s;
}

.controls button:hover {
  background: var(--border-color);
  color: var(--accent-color);
}

.sidebar {
  width: 100%;
  max-width: 380px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.card {
  background: var(--card-bg);
  padding: 16px;
  border-radius: 12px;
  border: 1px solid var(--border-color);
}

.card h3 {
  margin-top: 0;
  font-size: 16px;
  color: var(--text-muted);
}

textarea {
  width: 100%;
  height: 90px;
  background: #020617;
  border: 1px solid var(--border-color);
  color: var(--text-main);
  border-radius: 8px;
  padding: 10px;
  box-sizing: border-box;
  resize: none;
  font-family: monospace;
  font-size: 12px;
}

.button-group {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.btn-primary {
  flex: 1;
  background: var(--accent-color);
  color: #000;
  border: none;
  padding: 10px;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
}

.btn-primary:hover {
  background: var(--accent-hover);
}

.btn-secondary {
  background: var(--border-color);
  color: var(--text-main);
  padding: 10px 15px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
}

.moves-list {
  max-height: 250px;
  overflow-y: auto;
  font-family: monospace;
}

.move-row {
  display: flex;
  padding: 4px 8px;
  border-bottom: 1px solid #33415522;
}

.move-number {
  width: 40px;
  color: var(--text-muted);
}

.move-btn {
  flex: 1;
  background: none;
  border: none;
  color: var(--text-main);
  cursor: pointer;
  text-align: center;
  padding: 2px;
  border-radius: 4px;
}

.move-btn.active {
  background: var(--accent-color);
  color: #000;
  font-weight: bold;
}
